# ==============================================================================
# Ethiyo Configuration Environment Variables
# Copy this file to .env for local overrides
# ==============================================================================

# Server configuration
PORT=8080
ENV=development

# Chalo base API service URL
CHALO_BASE_URL=https://chalo.com

# HTTP and Browser timeouts
REQUEST_TIMEOUT=15s
BROWSER_TIMEOUT=15s

# Browser automation settings
# Leave BROWSER_PATH empty to auto-discover Chrome, Chromium, Brave, or Edge
BROWSER_PATH=
BROWSER_HEADLESS=true
BROWSER_MAX_CONCURRENCY=4

# Google OAuth2 Credentials (Optional, leave blank if not using Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# Secret key used for HMAC-SHA256 OAuth state validation (auto-generated if empty)
OAUTH_STATE_SECRET=

# Security and Middleware
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_RPS=10.0
RATE_LIMIT_BURST=20
